@*@model IEnumerable<ContosoUniversity.Models.Student>*@
@model PaginatedList<Student>

@{
    ViewData["Title"] = "Index";
}

<div class="controls">
	<h1>Students</h1>

	<form asp-action="Index" method="get">
		<div>
			<lable>Поиск по имени: <input type="search" name="SearchString" value="@ViewData["CurrentFilter"]" /></lable>
			<input type="submit" value="Найти" class="btn btn-primary" />
			<a asp-action="Index" class="btn btn-secondary">Сброс</a>
		</div>
	</form>

	<a asp-action="Create" class="btn btn-primary">Create New</a>
</div>

<div class="paginator">
	<table class="table">
		<thead>
			<tr>
				<th>
					@*<a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]">@Html.DisplayNameFor(model => model.LastName)</a>*@
					<a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]">LastName</a>
				</th>
				<th>
					@*@Html.DisplayNameFor(model => model.FirstName)*@
					First Name
				</th>
				<th>
					@*<a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParam"]"> @Html.DisplayNameFor(model => model.EnrollmentDate)</a>*@
					<a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParam"]">EnrollmentDate</a>
				</th>
				@*<th>
						@Html.DisplayNameFor(model => model.Enrollments)
					</th>*@
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@Html.DisplayFor(model => item.LastName)
					</td>
					<td>
						@Html.DisplayFor(model => item.FirstName)
					</td>
					<td>
						@Html.DisplayFor(model => item.EnrollmentDate)
					</td>
					@*<td>
							@Html.DisplayFor(model => item.Enrollments)
						</td>*@
					<td>
						<a asp-action="Edit" asp-route-id="@item.ID">Edit</a> |
						<a asp-action="Details" asp-route-id="@item.ID">Details</a> |
						<a asp-action="Delete" asp-route-id="@item.ID">Delete</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>


@{
    string prevDisabled = Model.HasPreviosPage ? "" : "disabled";
    string nextDisabled = Model.HasNextPage ? "" : "disabled";
}

<div class="pagination-controls">
	<a asp-action="Index"
	   asp-route-pageNumber="@(Model.PageIndex - 1)"
	   asp-route-currentFilter="@ViewData["CurrentFilter"]"
	   class="btn btn-default @prevDisabled">
		Prev
	</a>
	@*<div>@Model.PageIndex</div>*@
	<div class="pages">
		@for (int i = 0; i < Model.TotalPages; i++)
		{
			@if (i + 1 == Model.PageIndex)
			{
				<a asp-action="Index" asp-route-pageNumber="@(i + 1)" class="page current-page">@(i + 1)</a>
			}
			else
			{
				<a asp-action="Index" asp-route-pageNumber="@(i + 1)" class="page">@(i + 1)</a>
			}
		}
	</div>
	<a asp-action="Index"
	   asp-route-pageNumber="@(Model.PageIndex + 1)"
	   asp-route-currentFilter="@ViewData["CurrentFilter"]"
	   class="btn btn-default @nextDisabled">
		Next
	</a>
</div>