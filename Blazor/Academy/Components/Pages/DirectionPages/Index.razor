@page "/directions"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<PV_521_ImportContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="directions/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.Directions">
    <PropertyColumn Property="direction => direction.DirectionName" />

    <TemplateColumn Context="direction">
        @*<a href="@($"directions/edit?directionid={direction.DirectionId}")">Edit</a> |*@
        <a href="@($"directions/details?directionid={direction.DirectionId}")">Details</a> @*|
        <a href="@($"directions/delete?directionid={direction.DirectionId}")">Delete</a>*@
    </TemplateColumn>
</QuickGrid>

@code {
    private PV_521_ImportContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
