@page "/groups/details"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<PV_521_ImportContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
	<h2>Group</h2>
	<hr />
	@if (group is null)
	 {
	 	<p><em>Loading...</em></p>
	 }
	 else
	 {
	 	<dl class="row">
	 		<dt class="col-sm-2">GroupName</dt>
	 		<dd class="col-sm-10">@group.GroupName</dd>
	 		<dt class="col-sm-2">Direction</dt>
	 		<dd class="col-sm-10">@group.Direction</dd>
	 		<dt class="col-sm-2">Weekdays</dt>
	 		<dd class="col-sm-10">@group.Weekdays</dd>
	 		<dt class="col-sm-2">StartTime</dt>
	 		<dd class="col-sm-10">@group.StartTime</dd>
	 		<dt class="col-sm-2">StartDate</dt>
	 		<dd class="col-sm-10">@group.StartDate</dd>
	 		@*<dt class="col-sm-2">Students</dt>
	 			<dd class="col-sm-10">@group.Students</dd>*@
	 	</dl>
	 
	 	<h3>Список студентов</h3>
	 	@if (group.Students.Any())
	 	 {
	 	 	<table class="table table-striped">
	 	 		<thead>
	 	 			<tr>
	 	 				<th>Last Name</th>
	 	 				<th>First Name</th>
	 	 				<th>Middle Name</th>
	 	 				<th>Email</th>
	 	 				<th>Phone</th>
	 	 				<th>Photo</th>
	 	 			</tr>
	 	 		</thead>
	 	 		<tbody>
	 	 			@foreach (Student? student in group.Students)
	 	 			{
						<tr>
							<td>@student.LastName</td>
							<td>@student.FirstName</td>
							<td>@student.MiddleName</td>
							<td>@student.Email</td>
							<td>@student.Phone</td>
							<td>
								@if (student.Photo != null && !string.IsNullOrEmpty(student.PhotoMimeType))
								{
									String? src = ImageHelper.ToBase64ImageSrc(student.Photo, student.PhotoMimeType);
									<img src="@src" alt="@student.LastName" style="max-width: 60px; height: auto; border-radius: 4px;" />
								}
								else
								{
									<!-- Заглушка, если фото нет -->
									<span class="text-muted">No photo</span>
								}
							</td>
						</tr>
	 	 			}
	 	 		</tbody>
	 	 	</table>
	 	 }
	 	 else
	 	 {
	 	 	<p>No students assigned to this group.</p>
	 	 }
	 
	 	<div class="mt-3">
	 		<a href=" @($"/groups/edit?groupid={group.GroupId}")">Edit</a>|
	 		<a href=" @($" / groups")" > Back to List</a>
	 	</div>
	 }
</div>

@code 
{
	private Group? group;
	private Direction? direction;

	[SupplyParameterFromQuery]
	private int GroupId { get; set; }

	protected override async Task OnInitializedAsync()
	{
		await using var context = DbFactory.CreateDbContext();
		group = await context.Groups
			.Include(g => g.Students)
			.FirstOrDefaultAsync(m => m.GroupId == GroupId);

		if (group is null)
		{
			NavigationManager.NavigateTo("notfound");
			return;
		}

		if (group.Direction.HasValue)
		{
			direction = await context.Directions
				.FirstOrDefaultAsync(d => d.DirectionId == group.Direction.Value);
		}
	}
}