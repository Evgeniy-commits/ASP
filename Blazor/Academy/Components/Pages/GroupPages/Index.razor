@page "/groups"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<PV_521_ImportContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
	<a href="groups/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.Groups">
	<PropertyColumn Property="group => group.GroupName" />
	<PropertyColumn Property="group => group.Direction" />
	<PropertyColumn Property="group => group.Weekdays" />
	<PropertyColumn Property="group => group.StartTime" />
	<PropertyColumn Property="group => group.StartDate" />
	@*<PropertyColumn Property="group => group.Students" />*@

	<TemplateColumn Context="group">
		@*<a href="@($"groups/edit?groupid={group.GroupId}")">Edit</a> |*@
		<a href="@($"groups/details?groupid={group.GroupId}")">Details</a>
		@*| <a href="@($"groups/delete?groupid={group.GroupId}")">Delete</a>*@
	</TemplateColumn>
</QuickGrid>

@code {
	private PV_521_ImportContext context = default!;

	protected override void OnInitialized()
	{
		context = DbFactory.CreateDbContext();
	}

	public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
