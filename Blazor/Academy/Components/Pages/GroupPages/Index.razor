@page "/groups"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<PV_521_ImportContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer


<PageTitle>Группы</PageTitle>

<h1>Группы</h1>

<p>
	<a href="groups/create">Create New</a>
</p>

<div class="control">
	<div>
		<label>Направление:</label>
		<select @onchange="OnDirectionFilterChanged" class="from-select">
			<option value="">Все направления</option>
			@if (Directions != null)
			{
				foreach (var d in Directions)
				{
					<option value="@d.DirectionId" 
							selected="@(d.DirectionId.ToString() == DirectionFilter)">
						@d.DirectionName
					</option>
				}
			}
		</select>
	</div>
</div>
<QuickGrid TGridItem="Group" ItemsProvider="GroupsProvider" Class="table" @ref="_groupGrid">
	<PropertyColumn Property="group => group.GroupName" />
	<PropertyColumn Property="group => group.Direction" />
	<PropertyColumn Property="group => group.Weekdays" />
	<PropertyColumn Property="group => group.StartTime" />
	<PropertyColumn Property="group => group.StartDate" />
	@*<PropertyColumn Property="group => group.Students" />*@

	<TemplateColumn Context="group">
		@*<a href="@($"groups/edit?groupid={group.GroupId}")">Edit</a> |*@
		<a href="@($"groups/details?groupid={group.GroupId}")">Details</a>
		@*| <a href="@($"groups/delete?groupid={group.GroupId}")">Delete</a>*@
	</TemplateColumn>
</QuickGrid>

@code
{
	private List<Direction>? Directions { get; set; }

	[SupplyParameterFromQuery]
	string? DirectionFilter { get; set; }

	private QuickGrid<Group>? _groupGrid;

	//private PV_521_ImportContext context = default!;

	protected override async Task OnInitializedAsync()
	{
		await using var ctx = DbFactory.CreateDbContext();
		Directions = ctx.Directions.OrderBy(d => d.DirectionName).ToList();
	}

	private async ValueTask<GridItemsProviderResult<Group>> GroupsProvider(GridItemsProviderRequest<Group> request)
	{
		await using PV_521_ImportContext? context = DbFactory.CreateDbContext();
		IQueryable<Group>? query = context.Groups.AsQueryable();

		if (!string.IsNullOrEmpty(DirectionFilter) && byte.TryParse(DirectionFilter, out var dirId))
		{
			query = query.Where(g => g.Direction == dirId);
		}

		query = query.OrderBy(g => g.GroupName);

		int totalCount = await query.CountAsync();

		List<Group>? items = await query
						.Skip(request.StartIndex)
						.Take(request.Count ?? 100)
						.ToListAsync();

		return new GridItemsProviderResult<Group>
		{
			TotalItemCount = totalCount,
			Items = items
		};
	}

	private void OnDirectionFilterChanged(ChangeEventArgs e)
	{
		DirectionFilter = e.Value?.ToString();
		_groupGrid?.RefreshDataAsync();
	}

	public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}