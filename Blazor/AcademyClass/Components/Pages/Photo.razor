<img src="data:image/png; base64, @Convert.ToBase64String(Image)" alt="Photo"
	 style="@(IsDetailsPhoto ? "max-width: 50px; height: auto; border-radius: 4px;" : "")" />


@code
{

	[Parameter]
	public bool IsDetailsPhoto { get; set; } = false;

	[Parameter]
	public IBrowserFile? URL { get; set; }


	[Parameter]
	public byte[] Image { get; set; } = default!;
}


