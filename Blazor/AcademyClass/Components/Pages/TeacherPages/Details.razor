@page "/teachers/details"
@using Microsoft.EntityFrameworkCore
@using AcademyClass.Models
@inject IDbContextFactory<AcademyClassContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
	<h2>Teacher</h2>
	<hr />
	@if (teacher is null)
	{
		<p><em>Loading...</em></p>
	}
	else
	{
		<div class="details">
			<dl class="row">
				@*<dt class="col-sm-2">group</dt>
					<dd class="col-sm-10">@teacher.group</dd>
					<dt class="col-sm-2">Group</dt>
					<dd class="col-sm-10">@teacher.Group</dd>*@
				<dt class="col-sm-2">FullName</dt>
				<dd class="col-sm-10">@teacher.FullName</dd>
				@*<dt class="col-sm-2">last_name</dt>
					<dd class="col-sm-10">@teacher.last_name</dd>
					<dt class="col-sm-2">first_name</dt>
					<dd class="col-sm-10">@teacher.first_name</dd>
					<dt class="col-sm-2">middle_name</dt>
					<dd class="col-sm-10">@teacher.middle_name</dd>*@
				<dt class="col-sm-2">birth_date</dt>
				<dd class="col-sm-10">@teacher.birth_date</dd>
				<dt class="col-sm-2">email</dt>
				<dd class="col-sm-10">@teacher.email</dd>
				<dt class="col-sm-2">phone</dt>
				<dd class="col-sm-10">@teacher.phone</dd>
				<dt class="col-sm-2">WorkSince</dt>
				<dd class="col-sm-10">@teacher.WorkSince</dd>
				<dt class="col-sm-2">Rate</dt>
				<dd class="col-sm-10">@teacher.Rate</dd>
				<dt class="col-sm-2">photo</dt>
			</dl>
			<div class="photo-container">
				<div>
					@if (teacher.photo != null)
					{
						<Photo image="@teacher.photo" IsDetailsPhoto="false" />
					}
				</div>
			</div>
		</div>
		<div>
			<a href="@($"/teachers/edit?teacher_id={teacher.teacher_id}")">Edit</a> |
			<a href="@($"/teachers")">Back to List</a>
		</div>
	}
</div>

@code {
	private Teacher? teacher;

	[SupplyParameterFromQuery]
	private int teacher_id { get; set; }

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		teacher = await context.Teachers.FirstOrDefaultAsync(m => m.teacher_id == teacher_id);

		if (teacher is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}
}
