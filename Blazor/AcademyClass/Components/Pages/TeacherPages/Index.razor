@page "/teachers"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyClass.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyClassContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Teacher</PageTitle>

<div class="controls">
	<p>
		<a href="teachers/create" class="btn btn-primary">Добавить</a>
	</p>
</div>

<div>
	<QuickGrid Class="table" Items="teachers">
		@*<PropertyColumn Property="teacher => teacher.teacher_id" />*@
		<TemplateColumn Title="Name" Context="teacher">
			<a href="@($"teachers/details?teacher_id={teacher.teacher_id}")">@teacher.FullName</a>
		</TemplateColumn>
		@*<PropertyColumn Property="teacher => teacher.Age" />
		<PropertyColumn Property="teacher => teacher.last_name" />
		<PropertyColumn Property="teacher => teacher.first_name" />
		<PropertyColumn Property="teacher => teacher.middle_name" />*@
		<PropertyColumn Property="teacher => teacher.birth_date" />
		@*<PropertyColumn Property="teacher => teacher.group" />
		<PropertyColumn Property="teacher => teacher.Group" />*@
		@*<PropertyColumn Property="teacher => teacher.email" />
		<PropertyColumn Property="teacher => teacher.phone" />*@
		@*<PropertyColumn Property="teacher => teacher.photo" />*@
	<TemplateColumn Title="Photo" Context="t">
		
		@if (t.photo != null)
		{
			<Photo image="@t.photo" IsDetailsPhoto="true" />
		}
		else
		{
			<span class="text-muted">—</span>
		}
	</TemplateColumn>
		<PropertyColumn Property="teacher => teacher.WorkSince" />
		<PropertyColumn Property="teacher => teacher.Rate" />
		<TemplateColumn Context="teacher">
			@*<a href="@($"teachers/edit?teacher_id={teacher.teacher_id}")">Edit</a> |*@
			@*<a href="@($"teachers/details?teacher_id={teacher.teacher_id}")">Details</a>*@
			@*| <a href="@($"teachers/delete?teacher_id={teacher.teacher_id}")">Delete</a>*@
		</TemplateColumn>
	</QuickGrid>
</div>

@code 
{	
	private AcademyClassContext context = default!;
	private IQueryable<Teacher>? teachers;

	protected override void OnInitialized()
	{
		context = DbFactory.CreateDbContext();
		teachers = context.Teachers;
	}

	public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
