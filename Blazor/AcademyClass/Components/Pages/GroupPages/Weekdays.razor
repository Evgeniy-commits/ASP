@using AcademyClass.Components.Pages.GroupPages
@using AcademyClass.Models

@if (IsDetailsMode)
{
	
	<div style="text-align:start">@GetWeek().ToString()</div>
}
else
{
	<ul class="weekdays form-control">
		@for (int i = 0; i < 7; i++)
		{
			int idx = i;
			<li>
				<input type="checkbox"
					   id="@Week.DAYNAMES[idx]"
					   checked="@days[idx]"
					   @onchange="e => { days[idx] = e.Value is true; Compress(); }" />
				<label for="@Week.DAYNAMES[idx]">@Week.DAYNAMES[idx]</label>
			</li>
		}
	</ul>
	<input type="hidden" name="Group.learning_days" value="@(Group?.learning_days ?? 0)" />
}

@code
{
	bool[] days = new bool[7];

	[Parameter]
	public Models.Group? Group { get; set; }

	[Parameter]
	public bool IsDetailsMode { get; set; } = false;

	void Extract()
	{
		int mask = Group?.learning_days ?? 0;
		for (int i = 0; i < 7; i++)
			days[i] = ((mask >> i) & 1) != 0;
	}

	protected override void OnInitialized()
	{
		Extract();
	}

	//protected override void OnParametersSet()
	//{
	//	int mask = Group?.learning_days ?? 0;
	//	for (int i = 0; i < 7; i++)
	//		days[i] = ((mask >> i) & 1) != 0;
	//}

	void Compress()
	{
		int mask = 0;
		for (byte i = 0; i < 7; i++)
			if (days[i]) mask |= (1 << i);
		if (Group is not null)
			Group.learning_days = mask;

		StateHasChanged();

	}

	//private void UpdateMask()
	//{
	//	int mask = 0;

	//	for (int i = 0; i < 7; i++)
	//		if (days[i]) mask |= (1 << i);

	//	if (Group is not null)
	//		Group.learning_days = mask;

	//	StateHasChanged();
	//}

	private Week GetWeek() => new Week(Group?.learning_days ?? 0);
}
