@page "/groups"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using AcademyClass.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyClassContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="groups/create">Create New</a>
</p>

<QuickGrid Class="table" Items="groups">
	@*<PropertyColumn Property="group => group.group_name" />*@
	<TemplateColumn Title="Group" Context="group">
		<a href="@($"groups/details?group_id={group.group_id}")">@group.group_name</a>
	</TemplateColumn>
	<PropertyColumn Property="group => group.Direction.direction_name" />
	@*<PropertyColumn Property="group => group.learning_days" />*@
	<TemplateColumn Title="learning_days" Context="group">
		@WeekDayHelper.GetSelectedDaysString(group.learning_days)
	</TemplateColumn>
	<PropertyColumn Property="group => group.start_time" />
	<PropertyColumn Property="group => group.start_date" />

	@*<TemplateColumn Context="group">
			<a href="@($"groups/edit?group_id={group.group_id}")">Edit</a> |
			<a href="@($"groups/details?group_id={group.group_id}")">Details</a> |
			<a href="@($"groups/delete?group_id={group.group_id}")">Delete</a>
		</TemplateColumn>*@
</QuickGrid>

@code {
	private AcademyClassContext context = default!;
	//private List<Direction>? Directions { get; set; }
	IQueryable<Group> groups = default!;

	protected override void OnInitialized()
	{
		context = DbFactory.CreateDbContext();
		//Directions = context.Directions.OrderBy(d => d.direction_name).ToList();
		groups = context.Groups.Include(g=>g.Direction).OrderBy(g => g.group_name);
		
	}

	public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
