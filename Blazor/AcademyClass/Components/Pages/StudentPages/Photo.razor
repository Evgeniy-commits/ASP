<h3>Photo</h3>

<img src="data:image/jpeg; base64, @Convert.ToBase64String(Image)" alt="Photo" />

	@code
	{
		[Parameter]
		public IBrowserFile? URL { get; set; }

		[Parameter]
		public byte[] Image { get; set; } = default!;
	}

@*@if (Image != null && Image.Length > 0)
{
	// Определяем тип картинки (простой способ — по сигнатуре байтов)
	string mimeType = GetMimeType(Image);
	string base64 = Convert.ToBase64String(Image);

	<img src="data:@mimeType;base64,@base64" alt="Photo" />
}
else
{
	<span class="text-muted">Фото не загружено</span>
}

@code {
	[Parameter]
	public byte[]? Image { get; set; }

	private string GetMimeType(byte[] data)
	{
		if (data.Length < 4) return "image/jpeg";

		// Проверка сигнатуры файла
		if (data[0] == 0xFF && data[1] == 0xD8 && data[2] == 0xFF) return "image/jpeg";
		if (data[0] == 0x89 && data[1] == 0x50 && data[2] == 0x4E && data[3] == 0x47) return "image/png";
		if ((data[0] == 0x47 && data[1] == 0x49 && data[2] == 0x46) ||
			(data[0] == 0x42 && data[1] == 0x4D)) return "image/gif"; // упрощённо

		return "image/jpeg"; // запасной вариант
	}
}*@
