@inherits LayoutComponentBase
@using Blazor.Services

<ToggleMenuButton />

<div class="page-container" style="display: flex; min-height: 100vh; overflow: hidden;">

    <SidebarSection />

    <main class="content-wrapper" style="flex-grow: 1; overflow-y: auto; position: relative;">
        <div class="top-row px-4" style="padding-top: 0.5rem; padding-left: 60px;">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>
        <article class="content px-4" style="padding-left: 60px;">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

