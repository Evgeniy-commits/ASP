@rendermode InteractiveServer
@inherits ComponentBase
@implements IDisposable
@using Blazor.Services
@inject MenuStateService MenuService

<!-- Весь стиль сайдбара теперь здесь -->
<div class="sidebar @(MenuService.IsOpen ? "" : "collapsed")">
    <!-- Логотип можно вернуть сюда, если хочешь, чтобы он был частью меню -->
    <div class="sidebar-header px-3 py-2">
         <a class="navbar-brand text-white text-decoration-none" href="">Blazor</a>
    </div>

    <!-- Скролл только если меню открыто и контента много -->
    <div class="nav-scrollable" style="overflow-y: auto; height: calc(100vh - 50px);">
        <NavMenu />
    </div>
</div>

@code {
    private bool _isDisposed = false;

    protected override void OnInitialized()
    {
        MenuService.OnChange += HandleMenuChange;
    }

    private void HandleMenuChange()
    {
        if (_isDisposed) return;
        InvokeAsync(() => StateHasChanged());
    }

    public void Dispose()
    {
        _isDisposed = true;
        if (MenuService != null)
        {
            MenuService.OnChange -= HandleMenuChange;
        }
    }
}