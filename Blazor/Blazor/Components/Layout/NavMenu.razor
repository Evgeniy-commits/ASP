@rendermode InteractiveServer
@inherits ComponentBase
@using Blazor.Services
@inject MenuStateService MenuService

<div class="top-row ps-3 navbar navbar-dark" style="background-color: #343a40;">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <a class="navbar-brand" href="">Blazor</a>

        <button type="button" class="navbar-toggler"
                @onclick="HandleToggle"
                title="Toggle navigation">
            <span class="@arrowClass" aria-hidden="true"></span>
        </button>
    </div>
</div>

<!-- Добавлен overflow, чтобы меню не вылезало при сворачивании -->
<div class="nav-scrollable" style="overflow-y: auto;">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill me-2" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill me-2" aria-hidden="true"></span> Counter
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-cloud-sun-fill me-2" aria-hidden="true"></span> Weather
            </NavLink>
        </div>
        
        <!-- Твои кастомные страницы -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Factorial">
                <span class="bi bi-calculator me-2" aria-hidden="true"></span> Factorial
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Power">
                <span class="bi bi-power me-2" aria-hidden="true"></span> Power
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Fibonachy">
                <span class="bi bi-sort-numeric-down me-2" aria-hidden="true"></span> Fibonachy
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Minesweeper">
                <span class="bi bi-explode me-2" aria-hidden="true"></span> Minesweeper
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool isArrowDown = true;

    private string arrowClass => isArrowDown 
        ? "bi bi-chevron-down rotate-arrow-down" 
        : "bi bi-chevron-right rotate-arrow-right";

    private void HandleToggle()
    {
        isArrowDown = !isArrowDown;
        
        // Вызываем метод сервиса
        MenuService?.Toggle();
        
        System.Console.WriteLine("[NavMenu] Вызван сервис переключения");
    }
}