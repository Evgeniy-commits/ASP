@page "/minesweeper"
@using System.Net.Http.Json
@using Blazor.Models

<h3>Minesweeper</h3>

@if (isLoading)
{
	<p>Загрузка игры.....</p>
}
else if (gameState == null)
{
	<button @onclick="StartGame">Начать игру</button>
}
else
{
	<div style="display: flex; gap: 20px; margin-bottom: 10px;">
		<input type="number" @bind="Rows" min="10" max="100" />
		<input type="number" @bind="Cols" min="10" max="100" />
		<input type="number" @bind="Mines" min="15" max="2000" />
		<button @onclick="StartGame">Старт</button>
		<button @onclick="RestartGame">Рестарт</button>
	</div>
	
	<div style="display: flex; gap: 10px; margin-bottom: 10px;">
		<span>Статус: @(gameState.IsWon ? "Победа!" : (gameState.IsGameOver ? "Поражение" : "Игра идет"))</span>
		<span>Осталось мин : @CalculateMines()</span>
	</div>

	<div style="display: grid; grid-template-columns: repeat(@Cols, 30px); gap: 2px; border: solid 2px #333; padding: 1px;
		max-width: 100%; overflow: auto;">
		@foreach (var row in gameState.Grid)
		{
			@foreach (var cell in row)
			{
				<div @onclick="() => HandleClick(cell.Row, cell.Col, false)"
					@oncontextmenu="e => HandleRightClickSync(e, cell.Row, cell.Col)"
					 style = "@GetCellStyle(cell)">

					 @if (cell.IsRevealed)
					 {
						 @if (cell.IsMine)
						 {
							 <span style = "font-size: 1.2em;">💣</span>
						 }
						 else if (cell.NeighborCount > 0)
						 {
							 <span style = "color : @GetNumberColor(cell.NeighborCount); font-weight: bold;">@cell.NeighborCount</span>
						 }
					 }
					 else if (cell.IsFlagged)
					 {
						 <span style = "font-size: 1.2em;">🚩</span>
					 }
				</div>
			}
		}
	</div>
}


@code 
{
	GameStateResponse? gameState;
	bool isLoading = false;
	int Rows = 10;
	int Cols = 10;
	int Mines = 15;

	 // 1. Внедряем фабрику, чтобы получить именованный клиент
    [Inject] IHttpClientFactory ClientFactory { get; set; } = default!;
    
    // ИЛИ, если хочешь проще, используй стандартный HttpClient, но тогда в Program.cs 
    // убери регистрацию именованного клиента и оставь просто AddHttpClient().
    // Ниже вариант с именованным клиентом (рекомендуемый):

    private HttpClient _httpClient;

    protected override void OnInitialized()
    {
        // Получаем клиент с базой https://localhost:7273/
        _httpClient = ClientFactory.CreateClient("MinesweeperAPI");
    }


	// Синхронный метод-обертка, чтобы избежать ошибки конвертации типов
    // Он принимает событие, делает preventDefault через JS (или просто игнорирует стандартное поведение, если повезет)
    // НО! Самый надежный способ в чистом Blazor без JS файлов - это просто обработать событие.
    // Браузер все равно покажет меню, если мы не используем JS.
    
    // ПОЭТОМУ: Используем трюк. Мы НЕ можем сделать preventDefault чисто на C#.
    // Нам нужно внедрить маленький JS скрипт прямо здесь.
    
    [Inject] IJSRuntime JS { get; set; } = default!;
    private IJSObjectReference? module;

    // protected override async Task OnAfterRenderAsync(bool firstRender)
    // {
    //     if (firstRender)
    //     {
    //         // Импортируем модуль, который содержит функцию preventDefault
    //         module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/prevent-default.js");
    //     }
   // }

    async Task HandleRightClickSync(MouseEventArgs e, int r, int c)
    {
        // 1. Предотвращаем стандартное меню браузера через JS
        if (module != null) 
        {
            await module.InvokeVoidAsync("prevent", e);
        }

        // 2. Выполняем логику игры
        await HandleRightClickLogic(r, c);
    }

    async Task HandleRightClickLogic(int r, int c)
    {
        if (gameState?.IsGameOver == true) return;

        await _httpClient.PostAsJsonAsync("api/game/toggle-flag", new { Row = r, Col = c });
        await FetchState();
    }

	async Task StartGame()
	{	
		Console.WriteLine("Start");
		isLoading = true;
		var request = new { Rows, Cols, Mines };
		try
		{
			var response = await _httpClient.PostAsJsonAsync("api/game/start", request);
			gameState = await response.Content.ReadFromJsonAsync<GameStateResponse>();
			StateHasChanged();
		}
		catch (HttpRequestException ex)
		{
			Console.WriteLine("Net error (CORS или недоступен API): " + ex.Message);
		}
		catch (Exception ex)
		{
			Console.WriteLine("Error to start: " + ex.Message);
		}
		finally { isLoading = false; }
	}

	async Task RestartGame()
	{
		isLoading = true;
        try
        {
            var response = await _httpClient.PostAsJsonAsync("api/game/restart", new {});
            gameState = await response.Content.ReadFromJsonAsync<GameStateResponse>();
			StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Restart error: " + ex.Message);
        }
        finally { isLoading = false; }
	}

	async Task FetchState()
	{
		try
		{
			gameState = await _httpClient.GetFromJsonAsync<GameStateResponse>("api/game/state");
			StateHasChanged();
		}
		catch (Exception ex)
		{
			Console.WriteLine("State error: " + ex.Message);
		}
	}

	async Task HandleClick(int r, int c, bool isChord)
	{
		if (gameState?.IsGameOver == true) return;

		var cell = gameState!.Grid[r][c];

		//Логика Chord(клетка открыта, вокруг цифры)
		if (cell.IsRevealed)
		{
			await _httpClient.PostAsJsonAsync("api/game/chord", new { Row = r, Col = c });
		}
		else
		{
			await _httpClient.PostAsJsonAsync("api/game/reveal", new { Row = r, Col = c });
		}
		await FetchState();
	}

	// async Task HandleRightClick(int r, int c)
	// {
	// 	if (gameState?.IsGameOver == true) return;

	// 	await Http.PostAsJsonAsync("api/game/toggle-flag", new { Row = r, Col = c });
	// 	await FetchState();
	// }

	string GetCellStyle(CellStateDto cell)
	{
		//Если состояние не загружено
		if (gameState == null) return "background-color: lightgray;";

		if (cell.IsRevealed && cell.IsMine && !gameState.IsWon) return "background-color: red; color: white;";
		if (cell.IsRevealed && cell.IsMine && gameState.IsWon) return "background-color: green; color: white;";
		if (cell.IsRevealed && cell.NeighborCount == 0) return "background-color: white;";
		if (cell.IsFlagged) return "background-color: yellow;";
		return "background-color: lightgray;";
	}

	string GetNumberColor(int number)
	{
		return number switch 
		{
			1 => "blue", 2 => "green", 3 => "red", 4 => "darkcyan",
			5 => "brown", 6 => "teal", 7 => "black", 8 => "darkgray",
			_ => "black"
		};
	}

	int CalculateMines()
	{
		if (gameState == null) return Mines;
		int flags = 0;
		foreach (var row in gameState.Grid)
			foreach (var cell in row)
				if (cell.IsFlagged) flags++;

		return Mines - flags;
	}
}
