@page "/minesweeper"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using Blazor.Models

<h3>Minesweeper</h3>

@if (isLoading)
{
	<p>Загрузка игры.....</p>
}
else if (gameState == null)
{
	<div style="text-align: center; margin-top: 20px;">
		<button @onclick="StartGame" style="padding: 10px 20px; font-size: 16px;">Начать игру</button>
		<p style="color: gray;">Параметры игры</p>
	</div>
}
else
{
	<div style="display: flex; gap: 15px; margin-bottom: 10px; align-items : center; flex-wrap: wrap;">
		<label>Строки</label>
		<input type="number" @bind="Rows" min="10" max="100" style="width: 60px;" />

		<label>Столбцы</label>
		<input type="number" @bind="Cols" min="10" max="100" style="width: 60px;" />

		<label>Мины</label>
		<input type="number" @bind="Mines" min="15" max="2000" style="width: 60px;" />

		<button @onclick="StartGame">Старт</button>
		<button @onclick="RestartGame">Рестарт</button>
	</div>
	
	<div style="display: flex; gap: 20px; margin-bottom: 10px; font-weight: bold;">
		<span>Статус: @(gameState.IsWon ? "Победа!" : (gameState.IsGameOver ? "Поражение" : "Игра идет"))</span>
		<span>Осталось мин : @CalculateMines()</span>
	</div>

	<div style="@GetGridStyle()" class="game-board">
		@foreach (var row in gameState.Grid)
		{
			@foreach (var cell in row)
			{
				<div @onclick="() => HandleClick(cell.Row, cell.Col, false)"
					@oncontextmenu="e => { HandleRightClick(e, cell.Row, cell.Col);}"
					 style = "@GetCellStyle(cell)">

					 @if (cell.IsRevealed)
					 {
						 @if (cell.IsMine)
						 {
							 <span style = "font-size: 12px;">💣</span>
						 }
						 else if (cell.NeighborCount > 0)
						 {
							 <span style = "color : @GetNumberColor(cell.NeighborCount); font-weight: bold;">@cell.NeighborCount</span>
						 }
					 }
					 else if (cell.IsFlagged)
					 {
						 <span style = "font-size: 12px;">🚩</span>
					 }
					 else if (gameState.IsGameOver && !gameState.IsWon && cell.IsMine)
                    {
                        <span style="font-size: 12px; color: red;">💣</span>
                    }
				</div>
			}
		}
	</div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
	<div style="color: red; margin-top: 10px; padding: 10px; background: #ffe6e6; border: solid 1px red;">
		Error: @errorMessage
		<button @onclick="ClearError" style="margin-left: 10px;">OK</button>
	</div>
}

@* 
   МАГИЯ ЗДЕСЬ: 
   Этот скрипт регистрирует глобальный обработчик. 
   Он срабатывает СРАЗУ при клике правой кнопкой, ДО того как браузер откроет меню.
   Он проверяет, есть ли у элемента класс 'no-context-menu' (мы его не ставим, значит он блокирует всё),
   ИЛИ мы можем сделать умнее: блокировать только для ячеек сетки.
   
   Для простоты: этот скрипт блокирует контекстное меню для ВСЕХ элементов внутри .game-board.
*@
<script>
    (function() {
        document.addEventListener('contextmenu', function(event) {
            var target = event.target;
            
            while (target && target !== document.body) {
                if (target.classList && target.classList.contains('game-board')) {
                    event.preventDefault();
                    return; 
                }
                target = target.parentNode;
            }
        }, true); 
    })();
</script>

@code 
{
	GameStateResponse? gameState;
	bool isLoading = false;
	string errorMessage = "";

	int Rows = 10;
	int Cols = 10;
	int Mines = 15;

	 // 1. Внедряем фабрику, чтобы получить именованный клиент
    [Inject] IHttpClientFactory ClientFactory { get; set; } = default!;

    // [Inject] IJSRuntime JS { get; set; } = default!;
    // ИЛИ, если хочешь проще, используй стандартный HttpClient, но тогда в Program.cs 
    // убери регистрацию именованного клиента и оставь просто AddHttpClient().
    // Ниже вариант с именованным клиентом (рекомендуемый):

    private HttpClient _httpClient = default!;

    protected override void OnInitialized()
    {
        // Получаем клиент с базой https://localhost:7273/
        _httpClient = ClientFactory.CreateClient("MinesweeperApi");
    }

	async Task StartGame()
	{	
		errorMessage = "";
		Console.WriteLine("Start");
		isLoading = true;
		var request = new { Rows, Cols, Mines };

		try
		{
			var response = await _httpClient.PostAsJsonAsync("api/game/start", request);

			if(!response.IsSuccessStatusCode)
			{
				var content = await response.Content.ReadAsStringAsync();
				throw new Exception($"API error: {response.StatusCode} - {content}");
			}

			gameState = await response.Content.ReadFromJsonAsync<GameStateResponse>();
			StateHasChanged();
		}
		catch (HttpRequestException ex)
		{
			errorMessage = $"Net error (CORS или недоступен API): + {ex.Message}";
			Console.WriteLine(errorMessage);

		}
		catch (Exception ex)
		{
			errorMessage = ex.Message;
			Console.WriteLine(errorMessage);
		}
		finally 
		{ 
			isLoading = false; 
		}
	}

	async Task RestartGame()
	{
		errorMessage = "";
		isLoading = true;
        try
        {
			if (gameState == null)
			{
				await StartGame();
				return;
			}

            var response = await _httpClient.PostAsJsonAsync("api/game/restart", new {});
            gameState = await response.Content.ReadFromJsonAsync<GameStateResponse>();
			StateHasChanged();
        }
        catch (Exception ex)
        {
           errorMessage = "Restart error: " + ex.Message;
        }
        finally 
		{ 
			isLoading = false; 
		}
	}

	async Task FetchState()
	{
		try
		{
			gameState = await _httpClient.GetFromJsonAsync<GameStateResponse>("api/game/state");
			StateHasChanged();
		}
		catch (Exception ex)
		{
			errorMessage = "State error: " + ex.Message;
		}
	}

	async Task HandleClick(int r, int c, bool isChord)
	{
		if (gameState?.IsGameOver == true || gameState?.IsWon == true) return;

		var cell = gameState!.Grid[r][c];

		//Логика Chord(клетка открыта, вокруг цифры)
		try
		{
			if (cell.IsRevealed && !cell.IsMine)
			{
				await _httpClient.PostAsJsonAsync("api/game/chord", new { Row = r, Col = c });
			}
			else
			{
				await _httpClient.PostAsJsonAsync("api/game/reveal", new { Row = r, Col = c });
			}
			await FetchState();
		}
		catch(Exception ex)
		{
			errorMessage = "Move error" + ex.Message;
		}
	}

	async Task HandleRightClick(MouseEventArgs e, int r, int c)
    {
        //e.PreventDefault(); // <-- ЭТО ОТМЕНЯЕТ СТАНДАРТНОЕ МЕНЮ БРАУЗЕРА
		// 1. Предотвращаем контекстное меню браузера через JS
        // Мы передаем null вместо e, так как JS сам возьмет event из замыкания или глобального контекста,
        // но самый надежный способ в Blazor - выполнить JS строку, которая обращается к событию.
        // Однако, самый простой и рабочий способ для MouseEventArgs - это вызвать JS функцию, 
        // которая принимает event, но мы должны передать его правильно.
        
		// await JS.InvokeVoidAsync("eval", "event.preventDefault();");

        if (gameState?.IsGameOver == true || gameState?.IsWon == true) return;

        try 
        {
            await _httpClient.PostAsJsonAsync("api/game/toggle-flag", new { Row = r, Col = c });
            await FetchState();
        }
        catch (Exception ex) 
        {
            errorMessage = "Ошибка флага: " + ex.Message;
        }
    }

	void ClearError() =>
			errorMessage = "";
	

	//UI методы-----------------------------------------------------------

	string GetGridStyle()
		{ 
			int cellSize = 15;
			int gap = 2;

			int totalWidth = (int)((Cols * cellSize) + ((Cols - 1) * 1.5 * gap) + 2);

			return $"display: grid; grid-template-columns: repeat({Cols}, {cellSize}px); gap: {gap}px; border: solid 2px #333; padding: 4px ;" + 
				   $"width: {totalWidth}px; max-width: 100%; overflow-x: auto; justify-content: center; box-sizing: border-box;";
		}

	string GetCellStyle(CellStateDto cell)
	{
		if (gameState == null) return "background-color: lightgray; width: 15px; height: 15px; display: flex;" + 
									"justify-content: center; align-items: center; cursor: pointer; user-select: none;";

        var baseStyle = "width: 15px; height: 15px; display: flex; justify-content: center;" + 
						"align-items: center; cursor: pointer; user-select: none; border-radius: 4px;";
        
        if (cell.IsRevealed)
        {
            baseStyle += "background-color: white; color: #333; box-shadow: inset 2px 2px 3px rgba(0,0,0,0.2), inset -2px -2px 3px rgba(255,255,255,0.8);";
            if (cell.IsMine && !gameState.IsWon) baseStyle += " background-color: #ffcccc;"; // Красная мина при поражении
        }
        else if (cell.IsFlagged)
        {
             baseStyle += "background-color: lightgreen; color: black; box-shadow: 2px 2px 2px rgba(0,0,0,0.3), -1px -1px 2px rgba(255,255,255,0.5);";
        }
        else
        {
            baseStyle += "background-color: #ccc; color: #555; box-shadow: 2px 2px 2px rgba(0,0,0,0.3), -1px -1px 2px rgba(255,255,255,0.5);";
        }

        return baseStyle;
	}

	string GetNumberColor(int number)
	{
		return number switch 
		{
			1 => "blue", 2 => "green", 3 => "red", 4 => "darkcyan",
			5 => "brown", 6 => "teal", 7 => "black", 8 => "darkgray",
			_ => "black"
		};
	}

	int CalculateMines()
	{
		if (gameState == null) return Mines;
		int flags = 0;
		foreach (var row in gameState.Grid)
			foreach (var cell in row)
				if (cell.IsFlagged) flags++;

		return Mines - flags;
	}
}
