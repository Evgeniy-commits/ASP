@page "/Fibonachy"
@rendermode InteractiveServer

@using System.Globalization;
@using System.Numerics;

<h3>Fibonachy</h3>

<p class="text-muted">
	Введите номер элемента. Большие значения поддерживаются.
	<br/>
	<small class="text-danger">Вводить целое число!!!</small>
</p>

<div class="mb-3">
	<label for="n" class="from-label">Номер элемента</label>
	<input type="number" class="from-control" id="n"
		@bind="nValue"
		@bind:event="oninput"
		@bind:after="Calculate"
		min="0"
		placeholder="Например, 10" />
	<div class="text-danger small">@resultError</div>
</div>

@if (!string.IsNullOrEmpty(resultError))
{
	<div class="alert alert-danger">@resultError</div>
}
else if (resultSet)
{
    <div class="card shadow-sm p-3 bg-white">
               
        <div class="mb-4">
            <span class="fw-bold">Ряд до элемента @nValue:</span>
            
            <div class="mt-2 text-secondary small text-break">
                @seqDisplay
            </div>
        </div>

       <div class="form-control bg-light border-success fw-bold text-center" 
             style="cursor: default; font-size: 1.1rem; min-height: 2.5rem;">
            @ResultValue.ToString()
        </div>
        
        <small class="text-muted d-block text-center mt-2">Fib(@nValue) = значение</small>
    </div>
}

<button class="btn btn-primary" @onclick="Calculate">Рассчитать</button>

